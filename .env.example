# ==========================================
# BugReplay AI — Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_bugreplay_ai_change_in_production_32chars
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite)
DB_PATH=./data/bugreplay.db

# AI Synthesis Engine (Google Gemini)
# Optional: If omitted, deterministic heuristic template synthesizer will be used automatically
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS & Domain Restrictions
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Client Application Settings (Vite)
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_URL=http://localhost:5173
